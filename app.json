{
  "expo": {
    "name": "QR Wise",
    "slug": "qr-wise-admin-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/ios-tinted.png",
    "scheme": "qrwiseadminmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qrwise.business",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "dark": "./assets/images/ios-tinted.png",
        "light": "./assets/images/ios-tinted.png",
        "tinted": "./assets/images/ios-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0C0E12"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.qrwise.business"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#0C0E12"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ],
      "expo-video",
      "expo-build-properties",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "backgroundColor": "#0C0E12"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba55d33d-d8f7-462b-9544-8c62e5451f5f"
      }
    },
    "owner": "rjuevesano"
  }
}
